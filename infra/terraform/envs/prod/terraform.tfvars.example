# Copy to terraform.tfvars and fill in. The real file is gitignored: it names
# your AWS account, and that does not belong in a public repository.
aws_profile    = "agora"
aws_account_id = "000000000000"
alert_email    = "tu@correo.es"

# While there is no domain, the panel is served from CloudFront. Add the real
# origin here once there is one.
allowed_origins = ["http://localhost:3000"]

# The commercial name comes from packages/core/src/brand.json, which is the one
# file to edit when it changes. Set it here only if this environment has to
# show a different one.
# app_name = "Agora"

# infra_name is deliberately absent: the physical names must not follow the
# brand. Renaming it recreates the DynamoDB table and loses its data.
