# Ajustes de tu máquina para los comandos de apps/tools. Cópialo a .env, que
# está en .gitignore y no se sube.
#
# Existe para no tener que exportar nada en cada terminal. Con AWS_PROFILE aquí,
# los comandos leen ese perfil y NO miran las variables de entorno, así que un
# AWS_SESSION_TOKEN caducado de otra cuenta ya no puede ganarles la partida.

AWS_PROFILE=hoyq

# Solo si trabajas desde WSL: allí ~ es el home de Linux, y el fichero de
# credenciales está en el de Windows.
# AWS_SHARED_CREDENTIALS_FILE=/mnt/c/Users/TU_USUARIO/.aws/credentials
# AWS_CONFIG_FILE=/mnt/c/Users/TU_USUARIO/.aws/config
