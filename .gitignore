# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
# Static export of the panel, produced by `pnpm --filter @agora/web build:static`
out/
.turbo/
*.tsbuildinfo

# Playwright: the browser's own reports and traces of a failed run
apps/web/test-results/
apps/web/playwright-report/
apps/mobile/test-results/
apps/mobile/playwright-report/
# The app exported for web, which is what its browser tests run against.
apps/mobile/.web-build/
apps/mobile/.web-build-api/
apps/web/blob-report/
apps/web/.playwright/

# Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Generated by `expo prebuild` on demand, never committed (see D-017)
apps/mobile/android/
apps/mobile/ios/

# The design canvas is assembled from .design/*.dc.html on demand: the
# assembled file is 2.5 MB of packaged editor, and no version of it is content.
.design/*.html
!.design/*.dc.html

# Environment
.env
.env.local
.env.*.local

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output
coverage/
.expo-smoke/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
# A saved plan is a binary snapshot of the whole infrastructure, including
# every attribute value. It belongs on a laptop, never in a public repository.
tfplan
*.tfplan
*.auto.tfvars
crash.log

# Written from the store credentials at build time, never committed: the
# fingerprint and the team id belong to accounts, not to the repository.
apps/web/public/.well-known/

# Credencial del proyecto de Firebase. La escribe la CI desde un secreto.
# Sin ruta: el fichero se descarga a donde sea y una credencial en un
# repositorio publico no se arregla borrandola despues.
google-services.json

# La clave de servicio de Firebase, que es la credencial de verdad: da acceso
# a los servicios del proyecto. Se sube a Expo desde el navegador o la CLI y
# no deberia vivir aqui, pero acaba en la carpeta del proyecto mas de una vez.
#
# El patron dice `adminsdk` y no solo `firebase` a proposito: `*firebase*` se
# tragaria tambien un fichero de codigo llamado, por ejemplo, firebase-push.ts,
# y un fuente ignorado en silencio es un fallo que cuesta horas encontrar.
*firebase-adminsdk*.json
