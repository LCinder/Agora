# Clave de la API de Claude, necesaria para leer carteles en el panel.
# Copia este fichero como .env.local y pon tu clave.
# Sin ella, el panel funciona igual y el botón de subir cartel avisa de que falta.
ANTHROPIC_API_KEY=

# Clave de la API de Gemini, necesaria para dibujar carteles en el panel.
# Se saca gratis en https://aistudio.google.com/apikey (unas 50 imágenes al día,
# sin tarjeta). Sin ella el panel funciona igual y el botón avisa de que falta.
# Ojo: en el nivel gratuito Google usa lo enviado para entrenar (ver D-018).
GEMINI_API_KEY=
